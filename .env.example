# ========================================================
# Configurações de Integração Helena CRM (flw.chat)
# ========================================================
# Obtenha seu token permanente no painel da Helena CRM em:
# Ajustes > Integrações > Integração via API (ex: pn_xxxxxxxxxxxxxxxxxxxxxx)
HELENA_API_TOKEN=

# URL Base da API da Helena (Padrão: https://api.wts.chat/core)
HELENA_API_URL=https://api.wts.chat/core

# ID do Painel de Negócios no CRM (ex: 813ecce6-69cf-4fc6-b5df-73c8d4db35d2)
HELENA_PANEL_ID=813ecce6-69cf-4fc6-b5df-73c8d4db35d2

# Porta da aplicação
PORT=3333

# ========================================================
# Configurações de Integração Imoview (Chaves, Captadores, Locadores)
# ========================================================
# 1. API Pública da Imoview (para detalhes, fotos, localização de chaves e captadores)
IMOVIEW_API_KEY=

# 2. Login Automático no App Imoview (para consultar proprietários/locadores via CarregarPessoas)
IMOVIEW_LOGIN=
IMOVIEW_SENHA=
IMOVIEW_CODIGO_CONVENIO=7071
IMOVIEW_ROTA=santosemello

# 3. Opcional: Sessão manual (fallback caso não queira usar login automático)
IMOVIEW_SESSION_ID=
IMOVIEW_AUTH_COOKIE=
IMOVIEW_GERENCIA_TOKEN=


